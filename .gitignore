# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Secret environment files
.env
.env.*
!.env.example

# IDE settings
.vscode/
.idea/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Chroma database
.chroma/

# Data files
# Keep landing/'s top-level sample data tracked, but NOT its per-run upload
# subfolders (data/landing/<run_id>/...) -- the app writes each UI upload
# into one of those, and they're ephemeral runtime data, not source.
**/data/**/*.csv
**/data/**/*.parquet
!data/landing/*.csv
!data/landing/*.parquet

# Generated reports, audit logs, and agent traces
data/reports/
audit_logs/
data/traces/

# OS files
.DS_Store
Thumbs.db
