# ============================================================
# HOW TO SET UP YOUR API KEY
# ============================================================
# This project uses GitHub Copilot as the primary LLM provider.
#
# STEP 1: Copy this file and rename it to .env
# STEP 2: Paste your GitHub Copilot token below (provided by your trainer).
# STEP 3: Save the file.
# STEP 4: Run the app -- no other keys needed.
#
# If you don't have a GitHub token, ask your trainer for one.
# ============================================================

GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=openai/gpt-4.1-mini

# (Optional) Only fill this in if you have a native Claude/Anthropic key
# and do NOT have a GitHub token. Leave it blank otherwise.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
