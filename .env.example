# Copy this file to .env and fill in your own secrets.
# Keep this file safe and do not commit real API keys.

# LLM provider selection
# Options: anthropic, github
#
# Leave this COMMENTED OUT (the default) so the app auto-detects which
# provider to use based on whichever key below you actually filled in
# (checked in order: github > anthropic -- github first, since a GitHub
# Copilot/Models token is the key this project is actually validated
# against; a native Anthropic key works too if that's what you have
# instead). Only uncomment and set this explicitly if you have BOTH keys
# filled in below and want to force a specific one -- an explicit value
# here always wins over auto-detection, so if you set this to "anthropic"
# but only fill in GITHUB_TOKEN, the app will still try (and fail) to use
# Anthropic.
# LLM_PROVIDER=github

# GitHub token: https://github.com/settings/tokens
# This is the primary key for this project -- if your trainer/team gave you
# a GitHub Copilot or GitHub Models token, put it here.
GITHUB_TOKEN=your_github_token_here

# GitHub model: default is openai/gpt-4.1-mini
GITHUB_MODEL=openai/gpt-4.1-mini

# Anthropic API key: https://console.anthropic.com/settings/keys
# Fallback provider -- fill this in instead of GITHUB_TOKEN if you have a
# native Claude API key rather than a GitHub token.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model: pin the dated model ID (not a rolling alias) so behavior
# and cost don't change under you without a deliberate upgrade.
# Other options if you need more reasoning power later: claude-sonnet-5 (higher
# cost, better for harder judgment calls), claude-opus-5 (highest cost, reserve
# for complex edge cases only)
# If you get a not_found_error, this dated snapshot has been retired -
# check https://docs.claude.com/en/docs/about-claude/models for the current list.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
