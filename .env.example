# Copy this file to .env and fill in your own secrets.
# Keep this file safe and do not commit real API keys.

# LLM provider selection
# Options: anthropic, groq, gemini, openai, github
# Recommended default: anthropic
LLM_PROVIDER=anthropic

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model: pin the dated model ID (not a rolling alias) so behavior
# and cost don't change under you without a deliberate upgrade.
# Other options if you need more reasoning power later: claude-sonnet-5 (higher
# cost, better for harder judgment calls), claude-opus-5 (highest cost, reserve
# for complex edge cases only)
# If you get a not_found_error, this dated snapshot has been retired -
# check https://docs.claude.com/en/docs/about-claude/models for the current list.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Groq API key: https://console.groq.com/keys
# Optional: only needed if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# GROQ_MODEL formatting rules:
# 1) Put each candidate model on its own comment line ABOVE the setting.
# 2) Do NOT place multiple model names after the value on the same line.
# Other options: openai/gpt-oss-120b, llama-3.1-8b-instant, llama-3.3-70b-versatile
# Recommended default/safe choice: openai/gpt-oss-20b
# Groq occasionally deprecates preview/instant model IDs (e.g. llama-3.1-8b-instant
# has returned model_not_found errors before) - if you get a 404 model_not_found
# error, check https://console.groq.com/docs/models for the current list.
# Note: openai/gpt-oss-20b and openai/gpt-oss-120b are "reasoning" models that
# think step-by-step before answering - the code calling Groq must hide that
# reasoning or downstream JSON parsing will break.
GROQ_MODEL=llama-3.3-70b-versatile

# Google API key: https://makersuite.google.com/app/apikey
# Optional: only needed if LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API key: https://platform.openai.com/api-keys
# Optional: only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model: default is gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# GitHub token: https://github.com/settings/tokens
# Optional: only needed if LLM_PROVIDER=github
GITHUB_TOKEN=your_github_token_here

# GitHub model: default is openai/gpt-4.1-mini
GITHUB_MODEL=openai/gpt-4.1-mini
